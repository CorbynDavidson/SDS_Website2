// Temporary Cloudflare review deployment. No production domain routes.
// Existing review enquiry database is explicitly bound for the main workers.dev URL.
// Preview deployments intentionally have no access to this database.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sds-website2",
  "main": "dist/server/cloudflare.js",
  "compatibility_date": "2026-10-01",
  "no_bundle": true,
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sds-enquiries",
      "database_id": "bb14ab54-b4eb-4300-9b5d-569636ec64fb"
    }
  ],
  "vars": {
    "RELEASE_MODE": "review",
    "EDITOR_PUBLISH_ENABLED": "true",
    "GITHUB_APP_ID": "5257347",
    "GITHUB_APP_INSTALLATION_ID": "169779665",
    "CHAT_AI_ENABLED": "false",
    "CHAT_AI_DAILY_LIMIT": "20",
    "CHAT_AI_MONTHLY_LIMIT": "300"
  },
  "previews": {
    "vars": {
      "RELEASE_MODE": "review",
      "EDITOR_PUBLISH_ENABLED": "false",
      "CHAT_AI_ENABLED": "false"
    }
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true
  }
}
