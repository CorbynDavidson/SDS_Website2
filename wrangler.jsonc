// Temporary Cloudflare review deployment. No production domain routes.
// D1 is bound for enquiry storage; private uploads and staff authentication
// must be configured separately before enquiries/admin features are enabled.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sds-website2",
  "main": "dist/server/cloudflare.js",
  "compatibility_date": "2026-10-01",
  "no_bundle": true,
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "RELEASE_MODE": "review"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sds-enquiries",
      "database_id": "bb14ab54-b4eb-4300-9b5d-569636ec64fb",
      "migrations_dir": "drizzle"
    }
  ]
}
